# Shared
NODE_ENV=development
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgresql://gwi:gwi@localhost:5432/gwi

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gwiadmin
S3_SECRET_KEY=gwiadmin123
S3_BUCKET=gwi-artifacts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Auth
AUTH_SECRET=dev-auth-secret-change-me-in-production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-auth-secret-change-me-in-production
# Local credentials seed (see docs/architecture/local-dev.md)
SEED_ADMIN_EMAIL=admin@git-with-it.local
SEED_ADMIN_PASSWORD=admin1234
SEED_ORG_SLUG=demo
SEED_ORG_NAME=Demo Org

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Worker
WORKER_TMP_DIR=.tmp/workspaces
GWI_GIT_BIN=gwi-git
GWI_PARSE_BIN=gwi-parse
GWI_LINK_BIN=gwi-link
GWI_GRAPH_BIN=gwi-graph
GWI_METRICS_BIN=gwi-metrics
MAX_CLONE_BYTES=2147483648
CLONE_TIMEOUT_MS=600000
# Local KMS stub for encrypting private-repo PATs
PAT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Neo4j (API graph reads/writes)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gwi-local-dev

# ClickHouse (metrics)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Optional OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
